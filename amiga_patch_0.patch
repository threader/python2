+NOICONS
+NOERRORHIGHLIGHT
+OPTIMIZERTIME
+INCLUDEDIR=xmltok
+INCLUDEDIR=xmlparse
+DEFINE XML_NS
+DEFINE XML_DTD
+DEFINE XML_BYTE_ORDER=21
