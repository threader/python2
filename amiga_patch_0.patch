+{
+	int gid;
+#ifdef AMITCP
+	if (!checkusergrouplib()) return NULL;
+#else
+	if (!checksocketlib()) return NULL;
+#endif
+	if (!PyArg_Parse(args, "i", &gid))
+		return NULL;
+	if (setgid(gid) < 0)
+		return amiga_error();
+	Py_INCREF(Py_None);
+	return Py_None;
+}
+#endif /* HAVE_SETGID */
