diff --git a/Amiga/CheckStack.c b/Amiga/CheckStack.c
new file mode 100644
index 00000000000..6f6e22b7c4c
--- /dev/null
+++ b/Amiga/CheckStack.c
@@ -0,0 +1,13 @@
+#include "protos.h"
+
+#ifdef __SASC
+int PyOS_CheckStack (void)
+{
+	/* Amiga SAS/C: Explicit check of available stack */
+	extern unsigned long stackavail(void);
+	extern long __STKNEED;
+	if(stackavail()<__STKNEED) return -1;
+	return 0;
+}
+#endif /* __SASC */
+
