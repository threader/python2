+int
+Tcl_AppInit(Tcl_Interp *interp)
+{
+	Tk_Window main;
+
+	main = Tk_MainWindow(interp);
+	if (Tcl_Init(interp) == TCL_ERROR) {
+		PySys_WriteStderr("Tcl_Init error: %s\n", Tcl_GetStringResult(interp));
+		return TCL_ERROR;
