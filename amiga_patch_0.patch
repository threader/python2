+CPU=68030
+PARAMETERS=REGISTERS
+ANSI
+NOSTACKCHECK
+UNSIGNEDCHARS
+NOERRORSOURCE
+OPTIMIZERINLINELOCAL
+NOVERSION
+STRICT
